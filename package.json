{
  "name": "mesay-portfolio",
  "version": "1.0.0",
  "description": "Mesay's Full-Stack MERN Portfolio",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "build": "npm run install-all",
    "install-server": "cd server && npm install",
    "install-client": "cd client && npm install",
    "install-all": "npm run install-server && npm run install-client",
    "dev": "cd server && npm run dev",
    "test": "echo 'No tests specified'",
    "vercel-build": "npm run install-all"
  },
  "engines": {
    "node": "18.x",
    "npm": "9.x"
  },
  "keywords": [
    "portfolio",
    "mern",
    "fullstack",
    "react",
    "nodejs",
    "mongodb",
    "express"
  ],
  "author": "Mesay",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "mongoose": "^7.5.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "nodemailer": "^6.9.4"
  }
}